        "campaignId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "enum": ["equipamento", "consumivel", "documento", "recurso", "chave"]
        },
        "quantity": {
          "type": "integer"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 240
        },
        "equipable": {
          "type": "boolean"
        },
        "equipped": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "campaignId",
        "name",
        "category",
        "quantity",
        "description",
        "equipable",
        "equipped",
        "createdAt",
        "updatedAt"
      ]
    },
    "NpcRecord": {
