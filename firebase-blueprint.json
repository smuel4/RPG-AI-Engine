          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "beforeSummary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        },
        "afterSummary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        },
        "worldTimeLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "campaignId",
        "sequence",
        "type",
        "summary",
        "actor",
        "beforeSummary",
        "afterSummary",
        "worldTimeLabel",
        "createdAt"
      ]
    },
    "Checkpoint": {
      "title": "Checkpoint",
