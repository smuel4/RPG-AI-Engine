{
  "entities": {
    "Campaign": {
      "title": "Campaign",
      "description": "Campanha independente de RPG com estado estruturado completo do protagonista, moedas, tempo do mundo e metadados.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "setting": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "currentLocation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": ["active", "archived"]
        },
        "revision": {
          "type": "integer"
        },
        "lastSequence": {
          "type": "integer"
        },
        "protagonist": {
          "type": "object",
          "description": "Dados estruturados do protagonista (ex: Samuel, 18 anos)."
        },
        "currency": {
          "type": "object",
          "description": "Moedas estruturadas (gold, silver, copper)."
        },
        "worldTime": {
          "type": "object",
          "description": "Calendário e horário estruturado do mundo."
        },
        "activeTimelineId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "timelineLineage": {
          "type": "array",
          "description": "Segmentos da linha temporal ativa usados para manter coerência narrativa após restauração de checkpoints."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "name",
        "setting",
        "currentLocation",
        "status",
        "revision",
        "lastSequence",
        "protagonist",
        "currency",
        "worldTime",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Item estruturado pertencente ao inventário de uma campanha.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
