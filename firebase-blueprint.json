  "firestore": {
    "/campaigns/{campaignId}": {
      "schema": {
        "$ref": "#/entities/Campaign"
      },
      "description": "Documento principal de cada campanha independente do usuário."
    },
    "/campaigns/{campaignId}/inventory/{itemId}": {
      "schema": {
        "$ref": "#/entities/InventoryItem"
      },
      "description": "Itens estruturados no inventário da campanha."
    },
    "/campaigns/{campaignId}/npcs/{npcId}": {
      "schema": {
        "$ref": "#/entities/NpcRecord"
      },
      "description": "Personagens conhecidos e relações do mundo na campanha."
    },
    "/campaigns/{campaignId}/narrative/{entryId}": {
      "schema": {
        "$ref": "#/entities/NarrativeEntry"
      },
      "description": "Entradas ordenadas de narrativa fixa inicial, ações do jogador e respostas."
    },
    "/campaigns/{campaignId}/events/{eventId}": {
      "schema": {
        "$ref": "#/entities/GameEvent"
      },
      "description": "Log auditável de eventos e mutações de estado."
    },
    "/campaigns/{campaignId}/checkpoints/{checkpointId}": {
      "schema": {
        "$ref": "#/entities/Checkpoint"
      },
      "description": "Snapshots manuais salvos para restauração de estado."
    }
  }
}
